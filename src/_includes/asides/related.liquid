<section>
	<h3>Related Posts</h3>
	
	<ul>
		{% assign counter = 0 %}
		{% for post in site.posts %}
			{% if page.url == post.url %}
				{% continue %}
			{% endif %}
			
			{% for tag in page.tags %}
				{% if post.tags contains tag %}
					<li><a href="{{ post.url }}">{{ post.title }}</a></li>
					{% assign counter = counter | plus: 1 %}
					{% break %}
				{% endif %}
			{% endfor %}
			
			{% if counter > includes.limit %}
				{% break %}
			{% endif %}
		{% endfor %}
	</ul>
</section>