---
layout: layouts/default.liquid
---

<section>
	<h1>{{ page.name }}</h1>
	<h2>{{ page.position }}</h2>

	{{ content }}
</section>

<section>
	<h1>Posts</h1>
	
	{% assign filtered_posts = site.posts | where: 'author', page.username %}
	{% for post in filtered_posts %}
		<article>
			<h1><a href="{{ post.url }}">{{ post.title }}</a></h1>
			{{ post.excerpt }}
		</article>
	{% endfor %}
</section>
