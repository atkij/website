---
layout: layouts/blog.liquid
---

<section>
	<h1>{{ page.title }}</h1>
	<p>
		{{ page.date | date_to_string }}
		{% assign author = site.authors | where: 'username', page.author | first %}
		{% if author %}
			- <a href="{{ author.url }} ">{{ author.name }}</a>
		{% endif %}
	</p>
	
	{{ content }}
	
	<p>
		<a {% if page.previous.url %}href="{{ page.previous.url }}"{% endif %}>Previous</a>
		<a {% if page.next.url %}href="{{ page.next.url }}"{% endif %}>Next</a>
	</p>
</section>